# 치즈케이크의 밤 — 비밀 값 자리표시자
# 복사해서 .env 를 만들고 거기에 실제 값을 넣는다:  cp .env.example .env
# .env 는 .gitignore 에 걸려 있어 커밋되지 않는다. 실제 값을 이 파일에 적지 말 것.

# 1) SAC 키
SAC_KEY=

# 2) Chat 키
CHAT_KEY=

# 3) SPUM 키 (SPUM Base / SAM Builder)
SPUM_KEY=

# 4) 마스터 키
MASTER_KEY=

# SAM 주소 — 게임 서버가 대신 부를 때 쓴다
SAM_BASE_URL=https://sam.soonsoon.ai/openai/v1

# 로컬 개발 서버 포트
PORT=8790
